# Use single thread for BLAS for better performance and reproducibility
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
# Pin Python's string hash seed for reproducibility -- otherwise ParCa's
# set()-typed sim_data attributes (e.g. secretion_exchange_molecules) get
# pickled in a different, hash-randomized iteration order every run, even
# with identical config/weights/seed.
PYTHONHASHSEED=0
# Pin Nextflow version for better reproducibility
NXF_VER=25.10.4
